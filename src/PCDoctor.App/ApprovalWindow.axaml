<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PCDoctor.App.ApprovalWindow"
        Title="Godkend kommando" Width="720" Height="460" WindowStartupLocation="CenterOwner" CanResize="True">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"
                   Text="PC Doctor vil køre denne PowerShell-kommando som din Windows-bruger. Den kører kun, hvis du godkender."/>
        <TextBlock DockPanel.Dock="Top" x:Name="DirText" TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="DenyButton" Content="Afvis" MinWidth="100" IsDefault="True"/>
            <Button x:Name="ApproveButton" Content="Kør kommandoen" MinWidth="140"/>
        </StackPanel>
        <TextBox x:Name="CommandBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas,Menlo,monospace"/>
    </DockPanel>
</Window>
