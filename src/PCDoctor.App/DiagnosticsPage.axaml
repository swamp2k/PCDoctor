<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCDoctor.App.DiagnosticsPage">
    <DockPanel Margin="24,20">
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
            <TextBlock Classes="h1" Text="Diagnostik"/>
            <TextBlock Classes="muted" FontSize="13" Text="Uden AI. Intet på PC'en bliver ændret."/>
        </StackPanel>
        <TabControl x:Name="Tabs" Padding="0,12,0,0"/>
    </DockPanel>
</UserControl>
