<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PCDoctor.App.DiagnosticsWindow"
        Title="Diagnostik" Width="920" Height="700" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Tjek computeren selv. Det bruger ikke AI, kræver ingen API-nøgle, og intet på PC'en bliver ændret. Vælg en fane; testen kører med det samme."/>
        <TabControl x:Name="Tabs"/>
    </DockPanel>
</Window>
