<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:PCDoctor.App"
        x:Class="PCDoctor.App.HistoryWindow"
        Title="Historik" Width="1100" Height="720" MinWidth="700" MinHeight="420" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Tidligere samtaler, gemt på denne PC. Vælg en samtale for at se spørgsmål og svar, hvad PC Doctor undersøgte, og præcis hvad der blev sendt til AI'en."/>
        <Grid ColumnDefinitions="300,6,*">
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="RefreshButton" Content="Opdater"/>
                    <Button x:Name="DeleteButton" Content="Slet samtalen" IsEnabled="False"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="EmptyText" Text="Ingen gemte samtaler endnu." Opacity="0.7" IsVisible="False" Margin="0,0,0,6"/>
                <ListBox x:Name="SessionList">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="app:SessionListItem">
                            <StackPanel Spacing="2" Margin="0,2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

            <TabControl Grid.Column="2" x:Name="DetailTabs" IsVisible="False">
                <TabItem Header="Samtale">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer>
                            <ItemsControl x:Name="ChatList" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="app:ChatItem">
                                        <Border Background="{Binding Background}" CornerRadius="6" Padding="10,8" Margin="0,4">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Who}" FontWeight="SemiBold" Opacity="0.8"/>
                                                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </TabItem>
                <TabItem Header="Aktivitet">
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer>
                            <ItemsControl x:Name="ActivityList" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="app:ActivityItem">
                                        <Expander HorizontalAlignment="Stretch" Margin="0,2" IsEnabled="{Binding HasDetail}">
                                            <Expander.Header>
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding TimeText}" Foreground="Gray"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Icon}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Title}"/>
                                                </TextBlock>
                                            </Expander.Header>
                                            <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"/>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </TabItem>
                <TabItem Header="API-forespørgsler">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,4,0,8" Opacity="0.8"
                                   Text="Hvert kald til AI'en (Claude) i denne samtale: præcis hvad der blev sendt, og hvad der kom tilbage. API-nøgle og andre hemmeligheder er skjult. Til fejlfinding."/>
                        <ScrollViewer>
                            <ItemsControl x:Name="ApiList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="app:ApiCallItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"/>
                                            <Button Grid.Column="1" Content="Vis forespørgsel" Tag="request" Margin="8,0,0,0"/>
                                            <Button Grid.Column="2" Content="Vis svar" Tag="response" Margin="8,0,0,0" IsEnabled="{Binding HasResponse}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Om samtalen">
                    <ScrollViewer>
                        <SelectableTextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="4" FontFamily="Consolas,Menlo,monospace" FontSize="12"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
