<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:PCDoctor.App"
        x:Class="PCDoctor.App.MainWindow"
        Title="PC Doctor" Width="1200" Height="800" MinWidth="900" MinHeight="560">
    <DockPanel>

        <!-- Sidebar: one button per page, and the mode and language at the bottom -->
        <Border DockPanel.Dock="Left" Width="230" Background="{StaticResource SidebarBrush}" Padding="14,20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,22">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <app:Icon Data="M3 12h4l2-5 4 10 2-5h6" Foreground="{StaticResource OnAccentBrush}" Width="22" Height="22"/>
                    </Border>
                    <TextBlock Text="PC Doctor" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource PageBrush}" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="{app:Tr TILSTAND, MODE, LÄGE, MODUS, MODUS}"/>
                        <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="dot" Fill="{StaticResource GreenBrush}"/><TextBlock Text="Read-only"/></StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="dot" Fill="{StaticResource AmberBrush}"/><TextBlock Text="Assisted"/></StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Classes="dot" Fill="{StaticResource RedBrush}"/><TextBlock Text="YOLO"/></StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                        <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" ToolTip.Tip="{app:Tr Sprog, Language, Språk, Språk, Sprache}"/>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <Button x:Name="ChatNavButton" Classes="nav active">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <app:Icon Data="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>
                            <TextBlock Text="{app:Tr Samtale, Chat, Samtal, Samtale, Chat}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiagnosticsButton" Classes="nav" ToolTip.Tip="{app:Tr 'Tjek hardware, forbrug, netværk, hændelser og spil uden AI', 'Check hardware, usage, network, events and games without AI', 'Kontrollera hårdvara, belastning, nätverk, händelser och spel utan AI', 'Sjekk maskinvare, belastning, nettverk, hendelser og spill uten AI', 'Hardware, Auslastung, Netzwerk, Ereignisse und Spiele ohne KI prüfen'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <app:Icon Data="M3 12h4l2-5 4 10 2-5h6"/>
                            <TextBlock Text="{app:Tr Diagnostik, Diagnostics, Diagnostik, Diagnostikk, Diagnose}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StutterButton" Classes="nav" ToolTip.Tip="{app:Tr Hvorfor hakker mit spil?, Why does my game stutter?, Varför hackar mitt spel?, Hvorfor hakker spillet mitt?, Warum ruckelt mein Spiel?}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <app:Icon Data="M6 7h12a4 4 0 0 1 4 4v3a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-3a4 4 0 0 1 4-4z M7 11v3 M5.5 12.5h3 M15.5 12h.01 M18 14h.01"/>
                            <TextBlock Text="{app:Tr Spillet hakker, Game stutters, Spelet hackar, Spillet hakker, Spiel ruckelt}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecordButton" Classes="nav" ToolTip.Tip="{app:Tr 'Optag CPU, grafikkort, RAM og disk, mens du bruger PC’en', 'Record CPU, graphics card, RAM and disk while you use the PC', 'Spela in CPU, grafikkort, RAM och disk medan du använder datorn', 'Ta opp CPU, skjermkort, RAM og disk mens du bruker PC-en', 'CPU, Grafikkarte, RAM und Festplatte aufzeichnen, während du den PC benutzt'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <app:Icon Data="M3 3v18h18 M7 15l4-4 3 3 5-6"/>
                            <TextBlock Text="{app:Tr Optag ydelse, Record performance, Spela in prestanda, Ta opp ytelse, Leistung aufzeichnen}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogReviewButton" Classes="nav" ToolTip.Tip="{app:Tr 'Få en logfil gennemgået uden at sende det hele til AI’en', 'Have a log file reviewed without sending all of it to the AI', 'Få en loggfil granskad utan att skicka allt till AI:n', 'Få en loggfil gjennomgått uten å sende alt til AI-en', 'Eine Logdatei prüfen lassen, ohne alles an die KI zu senden'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <app:Icon Data="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5 M9 13h6 M9 17h6"/>
                            <TextBlock Text="{app:Tr Log Review, Log Review, Log Review, Log Review, Log Review}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryButton" Classes="nav" ToolTip.Tip="{app:Tr 'Tidligere samtaler, og hvad der blev sendt til AI’en', 'Earlier chats, and what was sent to the AI', 'Tidigare samtal och vad som skickades till AI:n', 'Tidligere samtaler, og hva som ble sendt til AI-en', 'Frühere Chats und was an die KI gesendet wurde'}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <app:Icon Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0z M12 7v5l3 2"/>
                            <TextBlock Text="{app:Tr Historik, History, Historik, Historikk, Verlauf}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdateButton" Classes="nav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <app:Icon Data="M12 4v11 M7 10l5 5 5-5 M5 20h14"/>
                            <TextBlock Text="{app:Tr Søg efter opdatering, Check for updates, Sök efter uppdatering, Se etter oppdatering, Nach Updates suchen}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Classes="nav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <app:Icon Data="M4 6h9 M17 6h3 M15 4v4 M4 12h3 M11 12h9 M9 10v4 M4 18h11 M19 18h1 M17 16v4"/>
                            <TextBlock Text="{app:Tr Indstillinger, Settings, Inställningar, Innstillinger, Einstellungen}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The pages. The chat is here; the other pages are added in code the first time they are opened. -->
        <Panel x:Name="PageHost">
            <DockPanel x:Name="ChatPage" Margin="24,20">

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <TextBlock Classes="h1" Text="{app:Tr Samtale, Chat, Samtal, Samtale, Chat}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="NewChatButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <app:Icon Data="M12 5v14 M5 12h14" Width="16" Height="16"/>
                            <TextBlock Text="{app:Tr Ny samtale, New chat, Nytt samtal, Ny samtale, Neuer Chat}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Live gauges -->
                <UniformGrid DockPanel.Dock="Top" x:Name="GaugeRow" Columns="4" ColumnSpacing="12" Margin="0,0,0,12">
                    <app:GaugeTile x:Name="CpuTile" Label="CPU"/>
                    <app:GaugeTile x:Name="GpuTile" Label="{app:Tr Grafikkort, Graphics card, Grafikkort, Skjermkort, Grafikkarte}"/>
                    <app:GaugeTile x:Name="RamTile" Label="RAM"/>
                    <app:GaugeTile x:Name="DiskTile" Label="Disk"/>
                </UniformGrid>

                <Border DockPanel.Dock="Top" x:Name="ModeBanner" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse Classes="dot" x:Name="ModeDot"/>
                        <TextBlock x:Name="ModeText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" x:Name="KeyBanner" Background="{StaticResource AmberSoftBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse Classes="dot" Fill="{StaticResource AmberBrush}"/>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{app:Tr 'Der mangler en API-nøgle. Åbn Indstillinger og indsæt den.', 'An API key is missing. Open Settings and paste it in.', 'En API-nyckel saknas. Öppna Inställningar och klistra in den.', 'Det mangler en API-nøkkel. Åpne Innstillinger og lim den inn.', 'Ein API-Schlüssel fehlt. Öffne die Einstellungen und füge ihn ein.'}"/>
                    </StackPanel>
                </Border>

                <!-- Input -->
                <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Classes="muted" FontSize="12" Margin="4,8,0,0"/>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="6" Margin="0,12,0,0">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" x:Name="InputBox" Classes="bare" PlaceholderText="{app:Tr Beskriv problemet …, Describe the problem …, Beskriv problemet …, Beskriv problemet …, Beschreibe das Problem …}"
                                 AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="120" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="SendButton" Classes="accent" Content="{app:Tr Start, Start, Starta, Start, Start}" MinWidth="90" Margin="6,0,0,0"/>
                        <Button Grid.Column="2" x:Name="StopButton" Content="{app:Tr Stop, Stop, Stopp, Stopp, Stopp}" MinWidth="80" Margin="6,0,0,0" IsEnabled="False"/>
                    </Grid>
                </Border>

                <!-- Chat (left) and what PC Doctor checked (right) -->
                <Grid ColumnDefinitions="*,12,280">
                    <Border Grid.Column="0" Classes="card" Padding="8">
                        <ScrollViewer x:Name="ChatScroll">
                            <ItemsControl x:Name="ChatList" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="app:ChatItem">
                                        <Border Background="{Binding Background}" HorizontalAlignment="{Binding Align}" MaxWidth="680"
                                                CornerRadius="14" Padding="14,10" Margin="0,6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Who}" Classes="label"/>
                                                <app:MarkdownText Markdown="{Binding Text}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Classes="card" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="label" Text="{app:Tr HVAD JEG TJEKKEDE, WHAT I CHECKED, VAD JAG KONTROLLERADE, HVA JEG SJEKKET, WAS ICH GEPRÜFT HABE}" Margin="4,0,0,8"/>
                            <Button DockPanel.Dock="Bottom" x:Name="ShowRequestButton" Classes="quiet" Content="{app:Tr Vis seneste API-forespørgsel, Show latest API request, Visa senaste API-förfrågan, Vis siste API-forespørsel, Letzte API-Anfrage anzeigen}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="12" Margin="0,6,0,0"/>
                            <ScrollViewer x:Name="ActivityScroll">
                                <ItemsControl x:Name="ActivityList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="app:ActivityItem">
                                            <Expander HorizontalAlignment="Stretch" Margin="0,2" IsEnabled="{Binding HasDetail}">
                                                <Expander.Header>
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Ellipse Classes="dot" Width="8" Height="8" Fill="{Binding Dot}" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="13"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Classes="muted" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"/>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Panel>
    </DockPanel>
</Window>
