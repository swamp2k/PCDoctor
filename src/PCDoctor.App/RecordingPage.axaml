<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:PCDoctor.App"
             x:Class="PCDoctor.App.RecordingPage">
    <DockPanel Margin="24,20">

        <!-- Title, game and start/stop -->
        <TextBlock DockPanel.Dock="Top" x:Name="TitleText" Classes="h1"/>
        <TextBlock DockPanel.Dock="Top" x:Name="IntroText" Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,14"/>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,0,0,8">
            <ComboBox Grid.Column="0" x:Name="GameBox" Width="300"/>
            <Button Grid.Column="1" x:Name="RefreshGamesButton" ToolTip.Tip="{app:Tr Opdater listen over programmer, Refresh the list of programs, Uppdatera listan över program, Oppdater listen over programmer, Liste der Programme aktualisieren}" Padding="12,0" Margin="8,0,0,0">
                <app:Icon Data="M20 11a8 8 0 1 0-2.3 5.7 M20 4v7h-7" Width="16" Height="16"/>
            </Button>
            <CheckBox Grid.Column="2" x:Name="FpsBox" Content="{app:Tr Mål FPS, Measure FPS, Mät FPS, Mål FPS, FPS messen}" ToolTip.Tip="{app:Tr Windows beder om administrator-tilladelse, Windows asks for administrator permission, Windows ber om administratörsbehörighet, Windows ber om administratortillatelse, Windows fragt nach Administratorberechtigung}" Margin="16,0,0,0"/>
            <Button Grid.Column="4" x:Name="StartButton" Classes="record" MinWidth="100">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10" Fill="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{app:Tr Start, Start, Starta, Start, Start}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="5" x:Name="StopButton" Content="{app:Tr Stop, Stop, Stopp, Stopp, Stopp}" MinWidth="80" Margin="8,0,0,0" IsEnabled="False"/>
        </Grid>
        <TextBlock DockPanel.Dock="Top" x:Name="ElapsedText" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <!-- Averages (or live values while recording) -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,12,*,12,*,12,*,12,Auto" Margin="0,0,0,12">
            <app:GaugeTile Grid.Column="0" x:Name="CpuTile"/>
            <app:GaugeTile Grid.Column="2" x:Name="GpuTile"/>
            <app:GaugeTile Grid.Column="4" x:Name="RamTile"/>
            <app:GaugeTile Grid.Column="6" x:Name="DiskTile"/>
            <Border Grid.Column="8" x:Name="FpsCard" Classes="card" Padding="16,10" MinWidth="170" IsVisible="False">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="label" Text="FPS"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="dot" x:Name="FpsDot"/>
                        <TextBlock x:Name="FpsText" Classes="big"/>
                    </StackPanel>
                    <TextBlock x:Name="FpsDetail" Classes="muted" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom: earlier recordings, details, and ask -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Classes="muted" Text="{app:Tr Optagelser, Recordings, Inspelningar, Opptak, Aufzeichnungen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="RecordingBox" Width="210"/>
            <Button Grid.Column="3" x:Name="AskButton" Classes="accent" Content="{app:Tr Spørg PC Doctor om optagelsen, Ask PC Doctor about the recording, Fråga PC Doctor om inspelningen, Spør PC Doctor om opptaket, PC Doctor zur Aufzeichnung fragen}" IsEnabled="False"/>
        </Grid>
        <Expander DockPanel.Dock="Bottom" Header="{app:Tr Alle detaljer, All details, Alla detaljer, Alle detaljer, Alle Details}" HorizontalAlignment="Stretch" Margin="0,12,0,0">
            <ScrollViewer MaxHeight="180">
                <SelectableTextBlock x:Name="SummaryText" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" FontSize="12"/>
            </ScrollViewer>
        </Expander>

        <!-- Network monitor (game page only) -->
        <Border DockPanel.Dock="Top" x:Name="NetCard" Classes="card" Padding="16,10" Margin="0,0,0,12" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Spacing="2" MinWidth="240" Margin="0,0,20,0">
                    <TextBlock Classes="label" Text="{app:Tr NETVÆRK, NETWORK, NÄTVERK, NETTVERK, NETZWERK}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="dot" x:Name="NetDot"/>
                        <TextBlock x:Name="NetPingText" Classes="big"/>
                    </StackPanel>
                    <TextBlock x:Name="NetDetail" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <DockPanel Grid.Column="1">
                    <StackPanel DockPanel.Dock="Right" Spacing="2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="3" CornerRadius="2" Background="{x:Static app:PerfChart.NetBrush}" VerticalAlignment="Center"/><TextBlock Classes="muted" FontSize="12" Text="{app:Tr Ping, Ping, Ping, Ping, Ping}"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="3" CornerRadius="2" Background="{x:Static app:PerfChart.DiskBrush}" VerticalAlignment="Center"/><TextBlock Classes="muted" FontSize="12" Text="{app:Tr Trafik, Traffic, Trafik, Trafikk, Datenverkehr}"/></StackPanel>
                    </StackPanel>
                    <app:NetChart x:Name="NetGraph" Height="64"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Every running program right now (Live View only) -->
        <Border DockPanel.Dock="Right" x:Name="ProgramsCard" Classes="card" Padding="14,12" Width="330" Margin="12,0,0,0" IsVisible="False">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="label" Text="{app:Tr AKTIVE PROGRAMMER, ACTIVE PROGRAMS, AKTIVA PROGRAM, AKTIVE PROGRAMMER, AKTIVE PROGRAMME}" Margin="0,0,0,6"/>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,60,70" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Classes="muted" FontSize="12" Text="{app:Tr Program, Program, Program, Program, Programm}"/>
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="CPU" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Text="RAM" HorizontalAlignment="Right"/>
                </Grid>
                <ScrollViewer>
                    <ItemsControl x:Name="ProgramsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="app:ProgramRow">
                                <Grid ColumnDefinitions="*,60,70" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Cpu}" HorizontalAlignment="Right" FontSize="13"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Ram}" HorizontalAlignment="Right" FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Race / graphs toggle (game page only) -->
        <StackPanel DockPanel.Dock="Top" x:Name="ViewToggle" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" IsVisible="False">
            <Button x:Name="RaceButton" Classes="accent" Content="{app:Tr Løb, Race, Race, Løp, Rennen}"/>
            <Button x:Name="GraphsButton" Content="{app:Tr Grafer, Graphs, Grafer, Grafer, Diagramme}"/>
        </StackPanel>

        <!-- Race -->
        <Border DockPanel.Dock="Top" x:Name="RaceCard" Classes="card" Padding="18,14" IsVisible="False">
            <app:RaceView x:Name="Race" VerticalAlignment="Top"/>
        </Border>

        <!-- Chart -->
        <Border x:Name="ChartCard" Classes="card" Padding="14,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="18" Margin="4,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="3" CornerRadius="2" Background="{x:Static app:PerfChart.CpuBrush}" VerticalAlignment="Center"/><TextBlock Classes="muted" FontSize="13" Text="CPU"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="3" CornerRadius="2" Background="{x:Static app:PerfChart.GpuBrush}" VerticalAlignment="Center"/><TextBlock Classes="muted" FontSize="13" Text="{app:Tr Grafikkort, Graphics card, Grafikkort, Skjermkort, Grafikkarte}"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="3" CornerRadius="2" Background="{x:Static app:PerfChart.RamBrush}" VerticalAlignment="Center"/><TextBlock Classes="muted" FontSize="13" Text="RAM"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="14" Height="3" CornerRadius="2" Background="{x:Static app:PerfChart.DiskBrush}" VerticalAlignment="Center"/><TextBlock Classes="muted" FontSize="13" Text="Disk"/></StackPanel>
                </StackPanel>
                <app:PerfChart x:Name="Chart"/>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
