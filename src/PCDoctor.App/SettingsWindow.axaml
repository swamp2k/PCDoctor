<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:PCDoctor.App"
        x:Class="PCDoctor.App.SettingsWindow"
        Title="{app:Tr Indstillinger, Settings, Inställningar, Innstillinger, Einstellungen}" Width="620" Height="560" WindowStartupLocation="CenterOwner">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="10">
            <TextBlock Text="{app:Tr Anthropic API-nøgle, Anthropic API key, Anthropic API-nyckel, Anthropic API-nøkkel, Anthropic-API-Schlüssel}" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="{app:Tr 'Indsæt nøglen én gang. Den gemmes i Windows Credential Manager for din Windows-bruger og bruges automatisk derefter. Den gemmes aldrig i programfilen.', 'Paste the key once. It is stored in Windows Credential Manager for your Windows user and used automatically after that. It is never stored in the program file.', 'Klistra in nyckeln en gång. Den sparas i Windows Autentiseringshanteraren för din Windows-användare och används automatiskt sedan. Den sparas aldrig i programfilen.', 'Lim inn nøkkelen én gang. Den lagres i Windows Legitimasjonsbehandling for Windows-brukeren din og brukes automatisk etterpå. Den lagres aldri i programfilen.', 'Füge den Schlüssel einmal ein. Er wird in der Windows-Anmeldeinformationsverwaltung für deinen Windows-Benutzer gespeichert und danach automatisch verwendet. Er wird nie in der Programmdatei gespeichert.', Linux='Indsæt nøglen én gang. Den gemmes i en fil, som kun din bruger kan læse, og bruges automatisk derefter. Den gemmes aldrig i programfilen.|Paste the key once. It is stored in a file only your user can read, and used automatically after that. It is never stored in the program file.|Klistra in nyckeln en gång. Den sparas i en fil som bara din användare kan läsa och används automatiskt sedan. Den sparas aldrig i programfilen.|Lim inn nøkkelen én gang. Den lagres i en fil som bare brukeren din kan lese, og brukes automatisk etterpå. Den lagres aldri i programfilen.|Füge den Schlüssel einmal ein. Er wird in einer Datei gespeichert, die nur dein Benutzer lesen kann, und danach automatisch verwendet. Er wird nie in der Programmdatei gespeichert.'}"/>
            <TextBlock x:Name="KeyStatus"/>
            <TextBox x:Name="KeyBox" PasswordChar="•" PlaceholderText="sk-ant-…"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveKeyButton" Content="{app:Tr Gem nøgle, Save key, Spara nyckel, Lagre nøkkel, Schlüssel speichern}"/>
                <Button x:Name="TestButton" Content="{app:Tr Test forbindelse, Test connection, Testa anslutning, Test forbindelse, Verbindung testen}"/>
                <Button x:Name="RemoveKeyButton" Content="{app:Tr Fjern nøgle, Remove key, Ta bort nyckel, Fjern nøkkel, Schlüssel entfernen}"/>
            </StackPanel>
            <TextBlock x:Name="TestResult" TextWrapping="Wrap"/>

            <Separator Margin="0,8"/>
            <TextBlock Text="{app:Tr Model, Model, Modell, Modell, Modell}" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock x:Name="ModelInfo" TextWrapping="Wrap" Opacity="0.8"/>

            <Separator Margin="0,8"/>
            <TextBlock Text="{app:Tr Grænser, Limits, Gränser, Grenser, Grenzen}" FontWeight="SemiBold" FontSize="16"/>
            <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="{app:Tr Maks. runder pr. spørgsmål, Max. rounds per question, Max. omgångar per fråga, Maks. runder per spørsmål, Max. Runden pro Frage}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="IterationsBox" Minimum="1" Maximum="200" FormatString="0"/>
                <TextBlock Grid.Row="1" Text="{app:Tr Standard-tidsgrænse for kommando (sek.), Default time limit for a command (sec.), Standardtidsgräns för kommando (sek.), Standard tidsgrense for kommando (sek.), Standard-Zeitlimit für einen Befehl (Sek.)}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="TimeoutBox" Minimum="5" Maximum="3600" FormatString="0"/>
                <TextBlock Grid.Row="2" Text="{app:Tr Maks. tidsgrænse agenten må bede om (sek.), Max. time limit the agent may ask for (sec.), Max. tidsgräns agenten får be om (sek.), Maks. tidsgrense agenten kan be om (sek.), 'Max. Zeitlimit, das der Agent anfordern darf (Sek.)'}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="MaxTimeoutBox" Minimum="5" Maximum="7200" FormatString="0"/>
                <TextBlock Grid.Row="3" Text="{app:Tr Maks. tegn output sendt til modellen, Max. characters of output sent to the model, Max. tecken utdata som skickas till modellen, Maks. tegn utdata sendt til modellen, Max. Zeichen Ausgabe an das Modell}" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="OutputBox" Minimum="1000" Maximum="200000" Increment="1000" FormatString="0"/>
            </Grid>
            <Button x:Name="SaveLimitsButton" Content="{app:Tr Gem grænser, Save limits, Spara gränser, Lagre grenser, Grenzen speichern}" HorizontalAlignment="Left"/>
            <TextBlock x:Name="LimitsResult"/>
        </StackPanel>
    </ScrollViewer>
</Window>
